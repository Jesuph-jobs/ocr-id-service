REDIS_URL=redis://localhost:6379/0
BULLMQ_PREFIX=bull
BULLMQ_WORKER_NAME=moustachir-ocr
BULLMQ_CONCURRENCY=1
BULLMQ_LOCK_DURATION_MS=300000
BULLMQ_STALLED_INTERVAL_MS=60000
OCR_APP_IDS=moustachir
OCR_APP_MOUSTACHIR_PASSWORD=replace-with-a-32-plus-character-random-secret
OCR_RESPONSE_TTL_SECONDS=86400
OCR_LANGUAGES=fr,ar
OCR_MODEL_PROFILE=mobile
OCR_USE_GPU=false
OCR_DEBUG=false
OCR_DEBUG_DIR=data/output/debug
OCR_INPUT_DIR=data/input
OCR_MAX_IMAGE_MB=10
OCR_LOG_LEVEL=INFO
